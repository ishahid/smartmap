{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SmartMap",
  "version": "../package.json",
  "identifier": "dev.ishahid.smartmap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SmartMap",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://tiles.openfreemap.org tiles: http://tiles.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://tiles.openfreemap.org tiles: http://tiles.localhost",
        "worker-src": "'self' blob:",
        "font-src": "'self' data:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Desktop GIS viewer and annotation tool",
    "longDescription": "SmartMap opens GIS data files, shows them over a basemap and lets you draw your own annotation layers. A modern rebuild of SmartMap (2004).",
    "copyright": "© 2004–2026 Muhammad Imran Shahid",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": { "section": "science" }
    }
  }
}
